#!/data/data/com.termux/files/usr/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Runs a Wayland compositor or a whole session on the Chameleon app's screen,
# rendering with Android's GPU. Open the Chameleon app first (or within
# CHAMELEON_WAIT s).
#
#   chameleon startplasma-wayland       # a Plasma session
#   chameleon kwin_wayland konsole      # KWin plus a first app
#   chameleon weston                    # Weston
#   chameleon sway                      # sway
#   chameleon --install                 # put `chameleon` in $PREFIX/bin
#
# chameleon-kernel serves the card, the input devices and the link to the app
# for the whole session, as the kernel would. Every program in the session
# gets the same device layer: libchameleon.so (the card node, gbm's buffers),
# libchameleon_udev.so (udev and the evdev nodes) and this directory's libgbm.
set -e
SHIM_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

case "$1" in
"" | -h | --help)
    sed -n '2,17s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
--install)
    ln -sf "$SHIM_DIR/chameleon" "$PREFIX/bin/chameleon"
    echo "installed: $PREFIX/bin/chameleon -> $SHIM_DIR/chameleon"
    exit 0
    ;;
esac

for lib in libchameleon.so libchameleon_udev.so libgbm.so libEGL_chameleon.so; do
    if [ ! -f "$SHIM_DIR/$lib" ]; then
        echo "chameleon: $SHIM_DIR/$lib is missing" >&2
        exit 1
    fi
done

# The device layer for every program in the session (the bus's services
# too), as a device node is there for every program: the card, Chameleon's
# input devices and working udev monitors, and gbm on the card.
case ":${LD_PRELOAD:-}:" in
*":$SHIM_DIR/libchameleon.so:"*) ;;
*) export LD_PRELOAD="$SHIM_DIR/libchameleon.so:$SHIM_DIR/libchameleon_udev.so${LD_PRELOAD:+:$LD_PRELOAD}" ;;
esac
case ":${LD_LIBRARY_PATH:-}:" in
*":$SHIM_DIR:"*) ;;
*) export LD_LIBRARY_PATH="$SHIM_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
esac

# A session bus for the compositor and its desktop, started before anything else.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-$PREFIX/tmp/runtime-$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
# The standard file names of gbm and libdrm, which some programs load by name
# (Firefox: dlopen("libgbm.so.1"), dlopen("libdrm.so.2")); Termux installs
# them without the version.
NAMES_DIR="$XDG_RUNTIME_DIR/chameleon-lib"
mkdir -p "$NAMES_DIR"
ln -sf "$SHIM_DIR/libgbm.so" "$NAMES_DIR/libgbm.so.1"
[ ! -e "$PREFIX/lib/libdrm.so" ] || ln -sf "$PREFIX/lib/libdrm.so" "$NAMES_DIR/libdrm.so.2"
case ":$LD_LIBRARY_PATH:" in
*":$NAMES_DIR:"*) ;;
*) export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$NAMES_DIR" ;;
esac
# This session gets its displays from its own compositor, not from an outer
# X/Wayland server; with neither set, compositors pick their DRM backend.
unset WAYLAND_DISPLAY DISPLAY
export XDG_SESSION_TYPE=wayland

# Xwayland would find a card and gbm now, but the compositor can't import
# its GPU buffers yet: X11 apps render as before (Mesa, shared memory).
# Delete with the Xwayland glamor step.
export XWAYLAND_NO_GLAMOR=1

# EGL for the whole session: the Chameleon vendor first - it takes the
# compositor's GBM display and Wayland windows under a compositor running
# on Chameleon - then the installed vendors (Mesa) for everything else.
VENDOR_JSON="$XDG_RUNTIME_DIR/chameleon-egl-vendor.json"
printf '{"file_format_version": "1.0.0", "ICD": {"library_path": "%s"}}\n' \
    "$SHIM_DIR/libEGL_chameleon.so" > "$VENDOR_JSON"
VENDORS="$VENDOR_JSON"
if [ -n "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ]; then
    VENDORS="$VENDORS:$__EGL_VENDOR_LIBRARY_FILENAMES"
else
    for json in "$PREFIX"/share/glvnd/egl_vendor.d/*.json; do
        [ -f "$json" ] || continue
        case "${json##*/}" in *chameleon*) continue ;; esac
        VENDORS="$VENDORS:$json"
    done
fi
export __EGL_VENDOR_LIBRARY_FILENAMES="$VENDORS"

# The app can't open the socket in $PREFIX/tmp that chameleon-kernel
# connects to. A broker from the app's APK does, running here as the Termux
# user, and hands each connection to the app. It exits with this process
# ($$, the session after the exec below).
APP=io.github.harryl0l.chameleon
APK=$(env -u LD_PRELOAD -u LD_LIBRARY_PATH /system/bin/pm path "$APP" 2>/dev/null | sed -n 's/^package://p' | head -n 1)
if [ -z "$APK" ]; then
    echo "chameleon: the Chameleon app isn't installed (or Termux can't see it)" >&2
    exit 1
fi
export CHAMELEON_SOCKET=${CHAMELEON_SOCKET:-$PREFIX/tmp/chameleon-0}
CLASSPATH="$APK" env -u LD_PRELOAD -u LD_LIBRARY_PATH \
    /system/bin/app_process / --nice-name=chameleon-broker "$APP.Broker" "$$" "$CHAMELEON_SOCKET" \
    >"$XDG_RUNTIME_DIR/chameleon-broker.log" 2>&1 &

# The card, the input devices and the link to the app, as the kernel would
# be (shim/core/main.c): it answers before the command starts, and exits
# with this process too.
if ! env -u LD_PRELOAD -u LD_LIBRARY_PATH "$SHIM_DIR/chameleon-kernel" "$$"; then
    echo "chameleon: chameleon-kernel didn't start" >&2
    exit 1
fi

exec "$@"
