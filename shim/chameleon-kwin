#!/data/data/com.termux/files/usr/bin/sh
# Starts KWin (kwin_wayland --drm, unmodified) on the Chameleon app's screen,
# rendering with Android's GPU driver.
#
#   chameleon-kwin                 # just KWin
#   chameleon-kwin konsole         # KWin plus a first app
#   CHAMELEON_DPI=300 chameleon-kwin   # bigger default scale guess
#
# Open the Chameleon app first (or within CHAMELEON_WAIT seconds, default 30).
set -e

SHIM_DIR=${CHAMELEON_SHIM_DIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}
for lib in libchameleon.so libgbm.so libEGL_chameleon.so; do
    if [ ! -f "$SHIM_DIR/$lib" ]; then
        echo "chameleon-kwin: $SHIM_DIR/$lib is missing (set CHAMELEON_SHIM_DIR)" >&2
        exit 1
    fi
done

if command -v pgrep >/dev/null 2>&1 && pgrep -x kwin_wayland >/dev/null 2>&1; then
    echo "chameleon-kwin: another kwin_wayland is already running (pgrep -af kwin_wayland);" >&2
    echo "  only one can use the Chameleon app. Stop it first: pkill -x kwin_wayland" >&2
    exit 1
fi

# KWin wants a session bus. Start one *before* the shim variables are set:
# the shim restores LD_PRELOAD/LD_LIBRARY_PATH for child processes, so it must
# only be loaded into kwin_wayland itself.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

for old in libGLESv2.so.2 libEGL.so.1; do
    if [ -e "$SHIM_DIR/$old" ] || [ -L "$SHIM_DIR/$old" ]; then
        echo "chameleon-kwin: $SHIM_DIR/$old is left over from an older version and would hide" >&2
        echo "  glvnd; delete the kwin-shim directory and copy the new one in its place." >&2
        exit 1
    fi
done

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-$PREFIX/tmp/runtime-$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

export CHAMELEON_DRM_PATH=${CHAMELEON_DRM_PATH:-$PREFIX/tmp/chameleon-card0}
export KWIN_DRM_DEVICES=$CHAMELEON_DRM_PATH  # a name only; the shim answers for it
export KWIN_COMPOSE=O2ES                     # Android EGL is GLES-only
export KWIN_DISABLE_VULKAN=1
export KWIN_DRM_USE_MODIFIERS=0              # gralloc picks buffer layouts
export KWIN_NO_TIMER_QUERY=${KWIN_NO_TIMER_QUERY-1}  # Mali-G77 crashes (SIGBUS) on texture writes after GL_TIMESTAMP queries

# EGL/GLES: glvnd (Termux's libEGL.so.1 / libGLESv2.so.2) with the Chameleon
# vendor library as KWin's only vendor. If it is installed system-wide
# (egl_vendor.d), this still pins KWin to this copy. The vendor puts the
# original setting back once glvnd has loaded it, for KWin's children.
VENDOR_JSON="$XDG_RUNTIME_DIR/chameleon-egl-vendor.json"
printf '{"file_format_version": "1.0.0", "ICD": {"library_path": "%s"}}\n' \
    "$SHIM_DIR/libEGL_chameleon.so" > "$VENDOR_JSON"
export CHAMELEON_ORIG___EGL_VENDOR_LIBRARY_FILENAMES=${__EGL_VENDOR_LIBRARY_FILENAMES:-}
export __EGL_VENDOR_LIBRARY_FILENAMES="$VENDOR_JSON"

export CHAMELEON_ORIG_LD_PRELOAD=${LD_PRELOAD:-}
export CHAMELEON_ORIG_LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
export LD_LIBRARY_PATH="$SHIM_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"  # the fake libgbm.so
export LD_PRELOAD="$SHIM_DIR/libchameleon.so${LD_PRELOAD:+:$LD_PRELOAD}"

exec kwin_wayland --drm "$@"
