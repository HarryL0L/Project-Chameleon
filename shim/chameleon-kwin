#!/data/data/com.termux/files/usr/bin/sh
# Starts KWin (kwin_wayland --drm, unmodified) on the Chameleon app's screen,
# rendering with Android's GPU driver.
#
#   chameleon-kwin                 # just KWin
#   chameleon-kwin konsole         # KWin plus a first app
#   CHAMELEON_DPI=300 chameleon-kwin   # bigger default scale guess
#
# Open the Chameleon app first (or within CHAMELEON_WAIT seconds, default 30).
set -e

SHIM_DIR=${CHAMELEON_SHIM_DIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}
for lib in libchameleon.so libgbm.so libEGL.so.1 libGLESv2.so.2; do
    if [ ! -f "$SHIM_DIR/$lib" ]; then
        echo "chameleon-kwin: $SHIM_DIR/$lib is missing (set CHAMELEON_SHIM_DIR)" >&2
        exit 1
    fi
done

# KWin wants a session bus. Start one *before* the shim variables are set:
# the shim restores LD_PRELOAD/LD_LIBRARY_PATH for child processes, so it must
# only be loaded into kwin_wayland itself.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

if [ -L "$SHIM_DIR/libGLESv2.so.2" ]; then
    echo "chameleon-kwin: $SHIM_DIR/libGLESv2.so.2 is a symlink left by an older version;" >&2
    echo "  delete the kwin-shim directory and copy the new one in its place." >&2
    exit 1
fi

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-$PREFIX/tmp/runtime-$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

export CHAMELEON_DRM_PATH=${CHAMELEON_DRM_PATH:-$PREFIX/tmp/chameleon-card0}
export KWIN_DRM_DEVICES=$CHAMELEON_DRM_PATH  # a name only; the shim answers for it
export KWIN_COMPOSE=O2ES                     # Android EGL is GLES-only
export KWIN_DISABLE_VULKAN=1
export KWIN_DRM_USE_MODIFIERS=0              # gralloc picks buffer layouts

export CHAMELEON_ORIG_LD_PRELOAD=${LD_PRELOAD:-}
export CHAMELEON_ORIG_LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
export LD_LIBRARY_PATH="$SHIM_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_PRELOAD="$SHIM_DIR/libchameleon.so${LD_PRELOAD:+:$LD_PRELOAD}"

exec kwin_wayland --drm "$@"
