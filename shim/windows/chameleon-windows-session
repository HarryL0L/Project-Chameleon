#!/data/data/com.termux/files/usr/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# KWin's session for `chameleon --windows [APP...]`: has KWin load the script
# that gives each app window a screen of its own (chameleon-windows.js, next
# to this file), then starts the app. The session lasts as long as KWin: the
# script has KWin quit when the last app window is closed (many apps' first
# process ends at once, their window living in another), and KWin ends with
# this program if the app fails to start. Without an app the session stays
# until KWin is stopped (Ctrl+C where it was started).
#
# The session's environment is left in $XDG_RUNTIME_DIR/chameleon-session.env
# while it lasts: `chameleon --run APP...` starts further programs with it.
DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
SCRIPT=$DIR/chameleon-windows.js
if [ "${CHAMELEON_WINDOWS_ARGS:-0}" = 0 ]; then
    SCRIPT=${XDG_RUNTIME_DIR:-/tmp}/chameleon-windows.js
    sed 's/^const STAY = false;/const STAY = true;/' "$DIR/chameleon-windows.js" >"$SCRIPT"
fi
call() {
    method=$1
    shift
    dbus-send --session --print-reply --dest=org.kde.KWin /Scripting "org.kde.kwin.Scripting.$method" "$@" >/dev/null
}
if ! { call loadScript "string:$SCRIPT" string:chameleon-windows && call start; }; then
    echo "chameleon: KWin didn't take the script for app windows; they all stay on the first screen" >&2
fi
# Each screen's touchscreen belongs to its screen. The devices say so (udev's
# WL_OUTPUT), but KWin replaces that with its own setting, empty until set,
# so it is set here: event0 is the first screen's, event5 and up the further
# ones' (core/evdev.c). KWin keeps it for later sessions.
n=1
while [ "$n" -le "${CHAMELEON_SCREENS:-1}" ]; do
    dbus-send --session --print-reply --dest=org.kde.KWin "/org/kde/KWin/InputDevice/event$((n > 1 ? n + 3 : 0))" \
        org.freedesktop.DBus.Properties.Set string:org.kde.KWin.InputDevice string:outputName \
        "variant:string:DSI-$n" >/dev/null ||
        echo "chameleon: KWin didn't take screen $n's touchscreen; its touches may land on another screen" >&2
    n=$((n + 1))
done
# What the script tells chameleon-screens about a window's screen is watched
# for here, to do what a script can't:
# - A further screen gets the first screen's scale (and full brightness) the
#   first time a window is named on it (SetTitle, right when the script has
#   put it there): KWin guesses a scale for a monitor it hasn't seen, so the
#   app's windows would differ in size. KWin keeps what it is given;
#   kscreen-doctor is KDE's tool for the screens' setup.
# - A window's app (SetApp, its desktop file's name) gives the Android window
#   its icon: the desktop file names it, kiconfinder6 finds its file as KDE's
#   programs do, rsvg-convert draws an SVG as the PNG Android can show.
scale=$(kscreen-doctor -j 2>/dev/null | sed -n 's/^ *"scale": *\([0-9.]*\).*/\1/p' | head -n 1)
[ -n "$scale" ] || echo "chameleon: no kscreen-doctor: further windows keep the scale KWin picks" >&2
icon_of() { # $1 = a screen's number, $2 = an app's desktop file name
    case $2 in *[!A-Za-z0-9._-]* | "") return ;; esac
    icon=$2
    for dir in "$HOME/.local/share" "${PREFIX:-/usr}/share"; do
        if [ -r "$dir/applications/$2.desktop" ]; then
            icon=$(sed -n 's/^Icon=//p' "$dir/applications/$2.desktop" | head -n 1)
            break
        fi
    done
    case $icon in
    "") return ;;
    /*) file=$icon ;;
    *) file=$(kiconfinder6 "$icon" 2>/dev/null </dev/null) ;;
    esac
    case $file in
    *.svg | *.svgz)
        png=${XDG_RUNTIME_DIR:-/tmp}/chameleon-icon-$1.png
        rsvg-convert -w 192 -h 192 -o "$png" "$file" 2>/dev/null </dev/null || return
        file=$png
        ;;
    *.png) ;;
    *) return ;;
    esac
    dbus-send --session --dest=io.github.harryl0l.Chameleon --print-reply /Screens \
        io.github.harryl0l.Chameleon.Screens.SetIcon "string:$1" "string:$file" >/dev/null 2>&1 </dev/null
}
if command -v dbus-monitor >/dev/null 2>&1; then
    dbus-monitor --session "type='method_call',interface='io.github.harryl0l.Chameleon.Screens'" |
        while read -r word rest; do
            case "$word $rest" in
            "method call "*"member=SetTitle") call=title n= ;;
            "method call "*"member=SetApp") call=app n= ;;
            'string "'*'"')
                value=${rest#\"}
                value=${value%\"}
                case "$call:$n:$value" in
                title::[2-9])
                    case $seen in
                    *" $value "*) ;;
                    *)
                        if [ -n "$scale" ]; then
                            kscreen-doctor "output.DSI-$value.scale.$scale" >/dev/null 2>&1 </dev/null
                            # ...and full brightness: Android dims the glass, and KWin
                            # would darken the picture by what a desktop session left.
                            kscreen-doctor "output.DSI-$value.brightness.100" >/dev/null 2>&1 </dev/null
                        fi
                        seen="$seen $value "
                        ;;
                    esac
                    call=
                    ;;
                app::[1-9]) n=$value ;;
                app:[1-9]:*)
                    icon_of "$n" "$value"
                    call=
                    ;;
                *) call= ;;
                esac
                ;;
            *) call= ;;
            esac
        done &
else
    echo "chameleon: no dbus-monitor: further windows keep KWin's scale, and none has its app's icon" >&2
fi
i=1
set --
while [ "$i" -le "${CHAMELEON_WINDOWS_ARGS:-0}" ]; do
    eval "set -- \"\$@\" \"\$CHAMELEON_WINDOWS_ARG_$i\""
    unset "CHAMELEON_WINDOWS_ARG_$i"
    i=$((i + 1))
done
unset CHAMELEON_WINDOWS_ARGS
ENV_FILE=${XDG_RUNTIME_DIR:-/tmp}/chameleon-session.env
trap 'rm -f "$ENV_FILE"' EXIT
trap exit HUP INT TERM
(umask 077 && export -p >"$ENV_FILE.new") && mv "$ENV_FILE.new" "$ENV_FILE"
if [ $# = 0 ]; then
    echo "chameleon: the session is up; start apps in it with: chameleon --run APP" >&2
else
    "$@" || exit
fi
while kill -0 "$PPID" 2>/dev/null; do
    sleep 1
done
